PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prameya_fest

# Set to true when the database requires TLS (TiDB Cloud, Aiven, PlanetScale, ...).
# Leave false for a local XAMPP MySQL.
DB_SSL=false

# Generate a long random secret. Do not share or commit .env.
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h
